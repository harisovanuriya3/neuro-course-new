      "page": "/modules/[id]",
      "regex": "^/modules/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/modules/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
